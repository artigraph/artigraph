from collections.abc import Mapping
from typing import BinaryIO, Literal, TextIO, overload

class GCSFileSystem:
    @overload
    def open(self, path: str, mode: Literal["r", "w"]) -> TextIO: ...
    @overload
    def open(self, path: str, mode: Literal["rb", "wb"]) -> BinaryIO: ...
    def info(self, path: str) -> dict[str, str | int]: ...
    def glob(self, path: str) -> list[str]: ...
    def mkdir(self, path: str, create_parents: bool = True) -> None: ...
    def pipe(self, path: str | Mapping[str, bytes], value: bytes | None = None) -> None: ...
    def rm(self, path: str, recursive: bool = False) -> None: ...
